{
	"name": "micropad",
	"version": "4.7.0-1",
	"coreVersion": "4.7.0",
	"description": "A powerful note-taking app that helps you organise + take notes without restrictions.",
	"main": "main.js",
	"scripts": {
		"postinstall": "patch-package",
		"start": "yarn build && yarn electron . --is-dev --no-sandbox",
		"build": "yarn tsc -p tsconfig.json",
		"update-core": "rm -rf core && rm -rf tmp && mkdir tmp && wget https://github.com/MicroPad/MicroPad-Core/releases/download/v$(node -p \"require('./package.json').coreVersion\")/micropad.tar.xz -P ./tmp && cd tmp && tar -xf micropad.tar.xz && rm build/dist/*.map && cp -r build ../core && cd .. && rm -rf tmp",
		"pack": "yarn build && yarn electron-builder --dir",
		"dist": "yarn build && yarn electron-builder"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MicroPad/Electron.git"
	},
	"author": {
		"name": "Nick Webster",
		"email": "nick@nick.geek.nz"
	},
	"license": "MPL-2.0",
	"bugs": {
		"url": "https://github.com/MicroPad/Electron/issues"
	},
	"homepage": "https://getmicropad.com",
	"devDependencies": {
		"@types/mime": "^3.0.1",
		"@types/node": "^18.7.18",
		"electron": "~44.3.0",
		"electron-builder": "^26.15.3",
		"patch-package": "^8.0.1",
		"typescript": "^7"
	},
	"dependencies": {
		"electron-context-menu": "^3.1.2",
		"electron-window-state": "^5.0.3",
		"localforage": "^1.10.0",
		"mime": "^3.0.0"
	},
	"build": {
		"appId": "com.getmicropad.micropad",
		"productName": "µPad",
		"publish": {
			"provider": "github",
			"releaseType": "release"
		},
		"asarUnpack": [
			"preload.js"
		],
		"linux": {
			"target": [
				{
					"target": "tar.gz",
					"arch": [
						"x64",
						"arm64"
					]
				},
				{
					"target": "AppImage",
					"arch": [
						"x64",
						"arm64"
					]
				},
				"snap",
				"deb",
				"rpm",
				"pacman"
			],
			"executableName": "micropad",
			"category": "Office",
			"icon": "build/icons"
		},
		"pacman": {
			"depends": [
				"gtk3"
			]
		},
		"snap": {
			"publish": {
				"provider": "github",
				"releaseType": "release"
			}
		},
		"mac": {
			"icon": "build/icon.png",
			"target": {
				"target": "dmg",
				"arch": "universal"
			},
			"category": "public.app-category.productivity"
		},
		"win": {
			"icon": "build/icon.png",
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64",
						"arm64"
					]
				},
				"portable"
			]
		},
		"nsis": {
			"allowToChangeInstallationDirectory": true,
			"oneClick": false
		}
	}
}
